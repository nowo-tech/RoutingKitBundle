includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - vendor/*
        # Optional SeoKit bridge (class exists only when nowo-tech/seo-kit-bundle is installed)
        - src/Seo/RoutingKitSeoPathBuilderDecorator.php
        - src/DependencyInjection/Compiler/SeoKitBridgePass.php
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
