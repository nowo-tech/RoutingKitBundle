# APP_ENV: Symfony environment (dev/test/prod). In demos it is usually `dev`.
APP_ENV=dev

# APP_DEBUG: enable/disable detailed debug output (usually `1` in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Set classic for per-request PHP / easier hot-reload. Recreate with `docker compose up -d` after change (REQ-DEMO-010).
FRANKENPHP_MODE=worker

# APP_SECRET: secret used for signing/tokens. Must be safe (use a local-only value).
APP_SECRET=CHANGE_ME_LOCAL_SECRET

# PORT: host port published by Docker Compose for this demo (maps to container :80).
PORT=8058

# DEFAULT_URI: optional Symfony absolute URI base (tests/docs/tooling). Startup URL uses PORT only.
DEFAULT_URI=http://localhost:8058
