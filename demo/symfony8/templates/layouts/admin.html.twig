{#
  Demo host layout — the one-file bridge of REQ-UI-003 (nowo_ui_kit.layouts.admin): extends the demo base and
  renders every UiKit canonical block. The Routing Kit panel pages (UiKit scaffolds) render inside it; no bundle
  layout, no CDN.
#}
{% extends 'base.html.twig' %}

{% block html_attributes %}{% if nowo_ui_theme.hasTokens() %} data-nowo-ui-host-tokens{% endif %}{% endblock %}

{% block title %}{% block nowo_ui_document_title %}{% endblock %} · Routing Kit Demo{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {{ nowo_ui_tokens() }}
    {% block nowo_ui_head %}{% endblock %}
    {% block nowo_ui_styles %}{% endblock %}
{% endblock %}

{% block main_class %}demo-admin{% endblock %}

{% block body %}
    <nav class="demo-admin-nav" aria-label="Demo">
        {% block nowo_ui_navigation %}<a href="/">&larr; Demo home</a>{% endblock %}
    </nav>
    <div id="nowo-ui-content"{% if nowo_ui_bundle|default(null) %} data-nowo-ui-bundle="{{ nowo_ui_bundle }}"{% endif %}>
        {% block nowo_ui_page_header %}{% endblock %}
        {% block nowo_ui_flashes %}
            {{ include(nowo_ui_partial('flashes', nowo_ui_bundle|default(null)), {bundle: nowo_ui_bundle|default(null)}) }}
        {% endblock %}
        {% block nowo_ui_content %}{% endblock %}
    </div>
    {% block nowo_ui_modals %}{% endblock %}
{% endblock %}

{% block javascripts %}
    {# UiKit 2.2 `scripts` partial: every UiKit runtime (modal, confirm, dialog, toast, tabs, theme), no hand-kept list. #}
    {% if nowo_ui_scripts_enabled ?? true %}{{ include(nowo_ui_partial('scripts', nowo_ui_bundle|default(null))) }}{% endif %}
    {% block nowo_ui_scripts %}{% endblock %}
{% endblock %}
