{% extends 'base.html.twig' %}

{% block title %}Routing Kit Bundle Demo{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--primary" href="/_routing/">Open the routing panel</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Routing Kit Bundle',
        intro: 'FrankenPHP demo for nowo-tech/routing-kit-bundle: locale paths, canonical styles and the CRUD panel.',
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: {warning: ['Demo only, UNSAFE. No Security Bundle; security.access_roles is empty and allow_unauthenticated is true. Do not expose this instance publicly. Production: ROLE_ADMIN plus a firewall (see docs/SECURITY.md).']}}) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Admin', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><a href="/_routing/">Routing panel</a> (<code>/_routing</code>): locale paths, signed import / export</li>
                <li><a href="/_routing/redirects">URL redirects</a> (<code>/_routing/redirects</code>): operator redirects</li>
            </ul>
            <p>The panel pages extend the UiKit page scaffolds (REQ-UI-003) and render in this demo's host layout (<code>templates/base.html.twig</code>, <code>nowo_ui_kit.layouts.admin</code>).</p>
            <p>Mark controllers with <code>#[Routable]</code>, then create <code>(route, locale)</code> path rows. Paths are stored without <code>{_locale}</code>; the loader always applies <code>/{_locale}/…</code>.</p>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Sample pages', kind: 'list'} %}
        {% block section_body %}
            <ul>
                <li><a href="/about">About</a> (<code>app_about</code>)</li>
                <li><a href="/blog/hello-world">Blog post</a> (<code>app_blog_show</code>)</li>
                <li><a href="/health">Health</a></li>
            </ul>
        {% endblock %}
    {% endembed %}
{% endblock %}
