{% extends 'base.html.twig' %}

{% block title %}Blog — {{ slug }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="/">Home</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Blog: ' ~ slug,
        intro: 'Sample page for app_blog_show with a required slug parameter.',
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Route parameter', kind: 'detail'} %}
        {% block section_body %}
            <p>Sample page for <code>app_blog_show</code> with required <code>{slug}</code> param.</p>
        {% endblock %}
    {% endembed %}
{% endblock %}
