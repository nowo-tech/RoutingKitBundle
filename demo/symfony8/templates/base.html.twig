{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. It is also the
    host layout of the Routing Kit panel pages (nowo_ui_kit.layouts.admin). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Routing Kit',
    home_route: 'homepage',
    repository: 'https://github.com/nowo-tech/RoutingKitBundle',
    translation_domain: false,
    nav: [
        {label: 'Home', route: 'homepage', section: 'Demo'},
        {label: 'About', route: 'app_about', section: 'Demo'},
        {label: 'Blog post', route: 'app_blog_show', params: {slug: 'hello-world'}, section: 'Demo'},
        {label: 'Routing panel', route: 'nowo_routing_kit_panel', section: 'Routing Kit', active: ['nowo_routing_kit_panel*']},
        {label: 'URL redirects', route: 'nowo_routing_kit_redirects', section: 'Routing Kit', active: ['nowo_routing_kit_redirects*']},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Routing Kit Demo{% endblock %}{% endblock %}
