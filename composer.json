{
    "name": "nowo-tech/routing-kit-bundle",
    "description": "Symfony bundle for DB-driven locale routes, canonical URL styles, CRUD panel, and SeoKit compatibility.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "routing",
        "i18n",
        "locale",
        "canonical",
        "seo"
    ],
    "homepage": "https://github.com/nowo-tech/RoutingKitBundle",
    "support": {
        "issues": "https://github.com/nowo-tech/RoutingKitBundle/issues",
        "source": "https://github.com/nowo-tech/RoutingKitBundle",
        "docs": "https://github.com/nowo-tech/RoutingKitBundle/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/RoutingKitBundle/blob/main/docs/CHANGELOG.md"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "nowo-tech/ui-kit-bundle": "^1.4 || ^1.5",
        "php": ">=8.2 <8.6",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0",
        "symfony/finder": "^7.0 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.0 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "nowo-tech/phpstan-frankenphp": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0 <2.2.6",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.0",
        "symfony/asset": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/twig-bundle": "^7.0 || ^8.0",
        "twig/twig": "^3.12",
        "vincentlanglet/twig-cs-fixer": "^3.0"
    },
    "suggest": {
        "symfony/twig-bundle": "Required to render the routing CRUD panel",
        "symfony/translation": "Required for |trans in panel templates",
        "symfony/security-bundle": "Recommended: firewall + ROLE_ADMIN for /_routing",
        "nowo-tech/seo-kit-bundle": "Bridge: RoutingKit paths feed SeoKit canonical/hreflang (requires SeoPathBuilderInterface)",
        "doctrine/orm": "Implement RoutePathStorageInterface against Doctrine entities",
        "symfony/asset": "Required for the nowo_routing_kit named asset package (panel CSS via assets:install)"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\RoutingKitBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\RoutingKitBundle\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor"
        ]
    },
    "config": {
        "sort-packages": true,
        "root-version": "1.0.0-dev",
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --color=always",
        "test-coverage": "phpunit --color=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "update": "composer update --no-interaction",
        "validate": "composer validate --strict",
        "qa": [
            "@cs-check",
            "@test"
        ],
        "twig:lint": "twig-cs-fixer lint --config=.twig-cs-fixer.php",
        "twig:fix": "twig-cs-fixer fix --config=.twig-cs-fixer.php",
        "twig:fix:check": "twig-cs-fixer lint --config=.twig-cs-fixer.php --fix"
    }
}
