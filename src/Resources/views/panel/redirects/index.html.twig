{#
  URL redirects list (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage built by
  UrlRedirectPanelController; delete through the UiKit confirm dialog); status (created | saved | deleted | null);
  nav, nav_current, path_prefix, role_gate_disabled.
  Data block filled: nowo_ui_list_row.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoRoutingKitBundle' %}

{% block nowo_ui_page_header %}
    {{ parent() }}
    {{ include('@NowoRoutingKitBundle/panel/_nav.html.twig') }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ parent() }}
    {{ include('@NowoRoutingKitBundle/panel/_notices.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'redirects.col.source'|trans }}"><code>{{ row.sourcePath }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'redirects.col.target'|trans }}"><code>{{ row.targetUrl }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'redirects.col.status'|trans }}">{{ row.statusCode }}</td>
    <td class="{{ _cell }}" data-label="{{ 'redirects.col.enabled'|trans }}">
        <span class="{{ nowo_ui_class(row.enabled ? 'badge_success' : 'badge_neutral', page.bundle) }}">{{ (row.enabled ? 'redirects.yes' : 'redirects.no')|trans }}</span>
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'redirects.col.hits'|trans }}" data-nowo-ui-priority="2">
        {{ row.hits }}
        {% if row.lastHitAt %}<span class="{{ nowo_ui_class('muted', page.bundle) }}">· {{ row.lastHitAt|date('Y-m-d H:i') }}</span>{% endif %}
    </td>
    <td class="{{ _cell }}{{ row.note ? '' : ' ' ~ nowo_ui_class('table_cell_muted', page.bundle) }}" data-label="{{ 'redirects.col.note'|trans }}" data-nowo-ui-priority="3">{{ row.note ?: '—' }}</td>
{% endblock %}
