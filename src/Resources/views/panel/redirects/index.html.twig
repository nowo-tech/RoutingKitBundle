{% extends '@NowoRoutingKitBundle/panel/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_routing_kit_css_framework|default('custom') %}

{% block title %}{{ 'redirects.title'|trans({}, 'NowoRoutingKitBundle') }}{% endblock %}

{% block body %}
{{ include('@NowoRoutingKitBundle/panel/_nav.html.twig', {current: 'redirects', path_prefix: path_prefix}) }}
<header class="nowo-ui-page-header">
    <h1>{{ 'redirects.title'|trans({}, 'NowoRoutingKitBundle') }}</h1>
    <p class="nowo-ui-muted muted">{{ 'redirects.intro'|trans({}, 'NowoRoutingKitBundle') }}</p>
    <div class="nowo-ui-actions actions">
        <a class="{{ ui.btn('primary', null, _css_fw) }} nowo-ui-action-create" href="{{ path_prefix }}/redirects/new" data-testid="redirect-new">{{ 'redirects.new'|trans({}, 'NowoRoutingKitBundle') }}</a>
    </div>
</header>
<main>
    {% if status %}
        <div class="{{ ui.flash('success', _css_fw) }}" role="status" data-testid="redirect-status">{{ ('redirects.status.' ~ status)|trans({}, 'NowoRoutingKitBundle') }}</div>
    {% endif %}
    <p class="nowo-ui-muted muted">{{ 'redirects.count'|trans({'%count%': total}, 'NowoRoutingKitBundle') }}</p>
    <div class="nowo-ui-table-wrap">
    <table class="nowo-ui-table" data-testid="redirect-table">
        <thead>
            <tr>
                <th>{{ 'redirects.col.source'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'redirects.col.target'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'redirects.col.status'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'redirects.col.enabled'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'redirects.col.hits'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'redirects.col.note'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th><span class="visually-hidden sr-only">{{ 'redirects.col.actions'|trans({}, 'NowoRoutingKitBundle') }}</span></th>
            </tr>
        </thead>
        <tbody>
        {% for redirect in redirects %}
            <tr>
                <td><code>{{ redirect.sourcePath }}</code></td>
                <td><code>{{ redirect.targetUrl }}</code></td>
                <td>{{ redirect.statusCode }}</td>
                <td>
                    <span class="{{ ui.badge(redirect.enabled ? 'success' : 'neutral', _css_fw) }}">{{ (redirect.enabled ? 'redirects.yes' : 'redirects.no')|trans({}, 'NowoRoutingKitBundle') }}</span>
                </td>
                <td>
                    {{ redirect.hits }}
                    {% if redirect.lastHitAt %}<span class="nowo-ui-muted muted">· {{ redirect.lastHitAt|date('Y-m-d H:i') }}</span>{% endif %}
                </td>
                <td>{{ redirect.note }}</td>
                <td>
                    <div class="{{ ui.row_actions(_css_fw) }} nowo-ui-row-actions--text">
                        <a class="{{ ui.action('edit', _css_fw) }}" href="{{ path_prefix }}/redirects/{{ redirect.id }}/edit">{{ 'panel.edit'|trans({}, 'NowoRoutingKitBundle') }}</a>
                        <a class="{{ ui.action('delete', _css_fw) }}" href="{{ path_prefix }}/redirects/{{ redirect.id }}/delete" data-testid="redirect-delete">{{ 'panel.delete'|trans({}, 'NowoRoutingKitBundle') }}</a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="7">{{ 'redirects.empty'|trans({}, 'NowoRoutingKitBundle') }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    {{ include('@NowoUiKitBundle/partials/_pagination.html.twig', {
        pagination: {
            page: page,
            per_page: page_size,
            total: total,
            total_pages: pages,
        },
        item_count: item_count,
        route: 'nowo_routing_kit_redirects',
        route_params: {},
        framework: _css_fw,
    }) }}
</main>
{% endblock %}
