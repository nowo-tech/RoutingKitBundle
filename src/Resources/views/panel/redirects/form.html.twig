{% extends '@NowoRoutingKitBundle/panel/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_routing_kit_css_framework|default('custom') %}
{% set _title = (redirect ? 'redirects.edit_title' : 'redirects.create_title')|trans({}, 'NowoRoutingKitBundle') %}

{% block title %}{{ _title }}{% endblock %}

{% block body %}
{{ include('@NowoRoutingKitBundle/panel/_nav.html.twig', {current: 'redirects', path_prefix: path_prefix}) }}
<header class="nowo-ui-page-header">
    <h1>{{ _title }}</h1>
    <p class="nowo-ui-muted muted">{{ 'redirects.form_hint'|trans({}, 'NowoRoutingKitBundle') }}</p>
</header>
<main>
    {{ form_start(form, {attr: {class: 'nowo-ui-form', 'data-testid': 'redirect-form'}}) }}
        {{ form_errors(form) }}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
        <div class="nowo-ui-actions actions">
            <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }} nowo-ui-action-save">{{ 'panel.save'|trans({}, 'NowoRoutingKitBundle') }}</button>
            <a class="{{ ui.btn('secondary', null, _css_fw) }} nowo-ui-action-cancel" href="{{ path_prefix }}/redirects">{{ 'panel.cancel'|trans({}, 'NowoRoutingKitBundle') }}</a>
        </div>
    {{ form_end(form) }}
</main>
{% endblock %}
