{#
  Panel section switcher (Routes | Redirects) under the page header, through the UiKit `tabs` partial (theme slots
  tabs, tab, tab_active; replace it for this bundle with nowo_ui_kit.theme.bundles.NowoRoutingKitBundle.partials.tabs).
  Variables: nav (PanelView::nav(), empty when url_redirects is off), nav_current (routes | redirects),
  path_prefix. A 1.x web_ui.partials.nav override (bridged to that partial) still receives current / path_prefix.
#}
{% if nav is not empty %}
    {{ include(nowo_ui_partial('tabs', 'NowoRoutingKitBundle'), {
        items: nav,
        aria_label: 'nav.label'|trans({}, 'NowoRoutingKitBundle'),
        bundle: 'NowoRoutingKitBundle',
        current: nav_current,
        path_prefix: path_prefix,
    }) }}
{% endif %}
