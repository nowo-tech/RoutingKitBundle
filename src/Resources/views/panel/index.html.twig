{#
  Route paths list (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage built by RoutingPanelController);
  import_form, import_display (inline | modal), import_modal_id; nav, nav_current, path_prefix, role_gate_disabled.
  Data blocks filled: nowo_ui_list_row, nowo_ui_list_after (inline import card); nowo_ui_modals (import modal).
  Section nav after the page header, panel notices after the host flashes.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoRoutingKitBundle' %}

{% block nowo_ui_page_header %}
    {{ parent() }}
    {{ include('@NowoRoutingKitBundle/panel/_nav.html.twig') }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ parent() }}
    {{ include('@NowoRoutingKitBundle/panel/_notices.html.twig') }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _cell = nowo_ui_class('table_cell', page.bundle) %}
    <td class="{{ _cell }}" data-label="{{ 'panel.col.route'|trans }}"><code>{{ row.routeName }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'panel.col.locale'|trans }}">{{ row.locale }}</td>
    <td class="{{ _cell }}" data-label="{{ 'panel.col.path'|trans }}"><code>{{ row.path }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'panel.col.canonical'|trans }}" data-nowo-ui-priority="3">{{ ('panel.form.canonical_style.' ~ row.canonicalStyle.value)|trans }}</td>
    <td class="{{ _cell }}" data-label="{{ 'panel.col.enabled'|trans }}" data-nowo-ui-priority="2">
        <span class="{{ nowo_ui_class(row.enabled ? 'badge_success' : 'badge_neutral', page.bundle) }}">{{ (row.enabled ? 'panel.yes' : 'panel.no')|trans }}</span>
    </td>
{% endblock %}

{% block nowo_ui_list_after %}
    {% if import_display != 'modal' %}
        {{ include(nowo_ui_partial('card', page.bundle), {
            id: 'routing-kit-import',
            title: 'panel.import_title'|trans,
            body: include('@NowoRoutingKitBundle/panel/_import_form.html.twig', {modal: false}),
            bundle: page.bundle,
        }) }}
    {% endif %}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {% if import_display == 'modal' %}
        {{ include(nowo_ui_partial('modal_shell', page.bundle), {
            id: import_modal_id,
            title: 'panel.import_title'|trans,
            body: include('@NowoRoutingKitBundle/panel/_import_form.html.twig', {modal: true}),
            bundle: page.bundle,
        }) }}
    {% endif %}
{% endblock %}
