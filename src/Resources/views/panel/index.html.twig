{% extends '@NowoRoutingKitBundle/panel/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_routing_kit_css_framework|default('custom') %}

{% block title %}{{ 'panel.title'|trans({}, 'NowoRoutingKitBundle') }}{% endblock %}

{% block body %}
<header class="nowo-ui-page-header">
    <h1>{{ 'panel.title'|trans({}, 'NowoRoutingKitBundle') }}</h1>
    <p class="nowo-ui-muted muted">{{ 'panel.subtitle'|trans({'%default%': default}, 'NowoRoutingKitBundle') }}</p>
    <div class="nowo-ui-actions actions">
        <a class="{{ ui.btn('primary', null, _css_fw) }} nowo-ui-action-create" href="{{ path_prefix }}/new">{{ 'panel.new'|trans({}, 'NowoRoutingKitBundle') }}</a>
        {{ form_start(export_form, {
            action: path_prefix ~ '/export',
            method: 'POST',
            attr: {style: 'display:inline'},
        }) }}
            {{ form_rest(export_form) }}
            <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">Export</button>
        {{ form_end(export_form, {render_rest: false}) }}
        {{ form_start(clear_cache_form, {
            action: path_prefix ~ '/clear-cache',
            method: 'POST',
            attr: {style: 'display:inline'},
        }) }}
            {{ form_rest(clear_cache_form) }}
            <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">{{ 'panel.clear_cache'|trans({}, 'NowoRoutingKitBundle') }}</button>
        {{ form_end(clear_cache_form, {render_rest: false}) }}
    </div>
</header>
<main>
    <p class="nowo-ui-muted muted">{{ total }} row(s)</p>
    <div class="nowo-ui-table-wrap">
    <table class="nowo-ui-table">
        <thead>
            <tr>
                <th>{{ 'panel.col.route'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'panel.col.locale'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'panel.col.path'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'panel.col.canonical'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th>{{ 'panel.col.enabled'|trans({}, 'NowoRoutingKitBundle') }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for row in definitions %}
            <tr>
                <td><code>{{ row.routeName }}</code></td>
                <td>{{ row.locale }}</td>
                <td><code>{{ row.path }}</code></td>
                <td>{{ row.canonicalStyle.value }}</td>
                <td>{{ row.enabled ? 'yes' : 'no' }}</td>
                <td>
                    <div class="{{ ui.row_actions(_css_fw) }} nowo-ui-row-actions--text">
                        <a
                            class="{{ ui.action('edit', _css_fw) }}"
                            href="{{ path_prefix }}/edit/{{ row.id }}"
                            title="{{ 'panel.edit'|trans({}, 'NowoRoutingKitBundle') }}"
                            aria-label="{{ 'panel.edit'|trans({}, 'NowoRoutingKitBundle') }}"
                        >{{ 'panel.edit'|trans({}, 'NowoRoutingKitBundle') }}</a>
                        {% if delete_forms[row.id] is defined %}
                            {{ form_start(delete_forms[row.id], {
                                action: path_prefix ~ '/delete/' ~ row.id,
                                method: 'POST',
                                attr: {
                                    class: 'nowo-ui-row-actions__form',
                                    onsubmit: "return confirm('Delete?');",
                                },
                            }) }}
                                {{ form_rest(delete_forms[row.id]) }}
                                <button
                                    type="submit"
                                    class="{{ ui.action('delete', _css_fw) }}"
                                    title="{{ 'panel.delete'|trans({}, 'NowoRoutingKitBundle') }}"
                                    aria-label="{{ 'panel.delete'|trans({}, 'NowoRoutingKitBundle') }}"
                                >{{ 'panel.delete'|trans({}, 'NowoRoutingKitBundle') }}</button>
                            {{ form_end(delete_forms[row.id], {render_rest: false}) }}
                        {% endif %}
                    </div>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">{{ 'panel.empty'|trans({}, 'NowoRoutingKitBundle') }}</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    {{ include('@NowoUiKitBundle/partials/_pagination.html.twig', {
        pagination: {
            page: page,
            per_page: page_size,
            total: total,
            total_pages: pages,
        },
        item_count: item_count,
        route: 'nowo_routing_kit_panel',
        route_params: {},
        framework: _css_fw,
    }) }}

    <h2>Import (signed JSON)</h2>
    {{ form_start(import_form, {
        action: path_prefix ~ '/import',
        method: 'POST',
        attr: {class: 'nowo-ui-form'},
    }) }}
        {{ form_row(import_form.payload_json) }}
        {{ form_row(import_form.replace_all) }}
        <div class="nowo-ui-actions actions">
            <button type="submit" class="{{ ui.btn('secondary', null, _css_fw) }}">Import</button>
        </div>
    {{ form_end(import_form) }}
</main>
{% endblock %}
