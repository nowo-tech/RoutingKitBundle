{% extends layout|default(nowo_routing_kit_layout_template) %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_routing_kit_css_framework|default('custom') %}
{# web_ui.ui_kit_assets: false when the host layout already loads nowo-ui.css (and its modal JS) before its own
   theme — re-appending the stylesheet last would reassert the UiKit :root tokens over the host theme. #}
{% block stylesheets %}
    {{ parent() }}
    {% if nowo_routing_kit_ui_kit_assets ?? true %}
    <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {% endif %}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% if (nowo_routing_kit_ui_kit_assets ?? true) and (nowo_routing_kit_import_display ?? 'inline') == 'modal' %}
        {% set _rk_nonce = app.request is defined and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
        <script src="{{ asset('js/nowo-ui-modal.js', 'nowo_ui_kit') }}" defer{% if _rk_nonce %} nonce="{{ _rk_nonce }}"{% endif %}></script>
    {% endif %}
{% endblock %}
