<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'panel.title'|trans({}, 'NowoRoutingKitBundle') }}</title>
    <style>
        :root { --bg: #f6f4ef; --ink: #1a1a1a; --accent: #0b6e4f; --line: #d9d2c5; }
        body { font-family: "IBM Plex Sans", "Segoe UI", sans-serif; margin: 0; background: var(--bg); color: var(--ink); }
        header, main { max-width: 960px; margin: 0 auto; padding: 1.5rem; }
        h1 { font-size: 1.5rem; margin: 0 0 0.5rem; }
        .muted { color: #5c5c5c; font-size: 0.95rem; }
        table { width: 100%; border-collapse: collapse; background: #fff; }
        th, td { border-bottom: 1px solid var(--line); padding: 0.65rem 0.75rem; text-align: left; font-size: 0.92rem; }
        .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1rem 0; }
        a.button, button { background: var(--accent); color: #fff; border: 0; padding: 0.5rem 0.9rem; text-decoration: none; cursor: pointer; font: inherit; }
        a.button.secondary, button.secondary { background: #444; }
        .errors { background: #ffe8e5; border: 1px solid #e7a59b; padding: 0.75rem; margin-bottom: 1rem; }
        label { display: block; margin: 0.75rem 0 0.25rem; font-weight: 600; }
        input, select { width: 100%; max-width: 32rem; padding: 0.45rem 0.5rem; font: inherit; }
        code { background: #eee; padding: 0.1rem 0.3rem; }
    </style>
</head>
<body>
{% if role_gate_disabled|default(false) %}
<header>
    <div class="errors" role="alert">
        <strong>UNSAFE:</strong> <code>panel.role</code> is disabled. Anyone who can reach this URL can manage routes.
        Use only on trusted local demos, or set <code>ROLE_ADMIN</code> and firewall the prefix.
    </div>
</header>
{% endif %}
{% block body %}{% endblock %}
</body>
</html>
