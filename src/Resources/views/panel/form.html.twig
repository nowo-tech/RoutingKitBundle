{% extends '@NowoRoutingKitBundle/panel/base.html.twig' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_routing_kit_css_framework|default('custom') %}

{% block title %}{{ definition and definition.id ? 'panel.edit_title'|trans({}, 'NowoRoutingKitBundle') : 'panel.create_title'|trans({}, 'NowoRoutingKitBundle') }}{% endblock %}

{% block body %}
<header class="nowo-ui-page-header">
    <h1>{{ definition and definition.id ? 'panel.edit_title'|trans({}, 'NowoRoutingKitBundle') : 'panel.create_title'|trans({}, 'NowoRoutingKitBundle') }}</h1>
    <p class="nowo-ui-muted muted">{{ 'panel.form_hint'|trans({}, 'NowoRoutingKitBundle') }}</p>
</header>
<main>
    {% if errors %}
        <div class="nowo-ui-error errors">
            {% for error in errors %}<div>{{ error }}</div>{% endfor %}
        </div>
    {% endif %}
    {% if conflicts %}
        <div class="nowo-ui-error errors">
            {% for conflict in conflicts %}<div>{{ conflict }}</div>{% endfor %}
        </div>
    {% endif %}
    {{ form_start(form, {attr: {class: 'nowo-ui-form'}}) }}
        {% for child in form %}
            {% if not child.rendered %}
                {{ form_row(child) }}
            {% endif %}
        {% endfor %}
        <div class="nowo-ui-actions actions">
            <button type="submit" class="{{ ui.btn('primary', null, _css_fw) }} nowo-ui-action-save">{{ 'panel.save'|trans({}, 'NowoRoutingKitBundle') }}</button>
            <a class="{{ ui.btn('secondary', null, _css_fw) }} nowo-ui-action-cancel" href="{{ path_prefix }}/">{{ 'panel.cancel'|trans({}, 'NowoRoutingKitBundle') }}</a>
        </div>
    {{ form_end(form) }}
</main>
{% endblock %}
