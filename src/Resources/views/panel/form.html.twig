{#
  Route path form (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage built by RoutingPanelController:
  title create / edit, submit, cancel, deleteAction on edit); definition, conflicts (conflict preview messages);
  nav_current, path_prefix, role_gate_disabled.
  Data block filled: nowo_ui_form_body (form errors and the conflict preview before the default child loop).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoRoutingKitBundle' %}

{% block nowo_ui_flashes %}
    {{ parent() }}
    {{ include('@NowoRoutingKitBundle/panel/_notices.html.twig') }}
{% endblock %}

{% block nowo_ui_form_body %}
    {{ form_errors(form) }}
    {% if conflicts is not empty %}
        <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="alert" data-testid="routing-kit-conflicts">
            {% for conflict in conflicts %}<p>{{ conflict }}</p>{% endfor %}
        </div>
    {% endif %}
    {{ parent() }}
{% endblock %}
